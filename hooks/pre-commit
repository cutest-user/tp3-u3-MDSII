#!/bin/sh
# Hook de pre-commit: formatter -> linter -> tests. Corta en el primer fallo.

set -e
cd "$(git rev-parse --show-toplevel)"

paso() {
    printf '\n[%s] %s\n' "$1" "$2"
}

paso "1/3" "Formatter (black --check)"
python -m black --check src tests

paso "2/3" "Linter (flake8)"
python -m flake8 src tests --max-line-length=100

paso "3/3" "Tests unitarios (pytest)"
python -m pytest -q

printf '\nControles OK, se crea el commit.\n'
